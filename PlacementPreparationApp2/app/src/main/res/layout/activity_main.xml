<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Title -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placement_preparation"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prepare_today_succeed_tomorrow"
            android:textSize="16sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp"/>


        <!-- Roadmap -->

        <Button
            android:id="@+id/roadmapButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/placement_roadmap"
            android:textSize="18sp"/>


        <!-- Coding Practice -->

        <Button
            android:id="@+id/codingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/coding_practice"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>


        <!-- Notes -->

        <Button
            android:id="@+id/notesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/study_notes"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>


        <!-- Resume -->

        <Button
            android:id="@+id/resumeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/resume_builder"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>


        <!-- Progress -->

        <Button
            android:id="@+id/progressButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_progress"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>


        <!-- Profile -->

        <Button
            android:id="@+id/profileButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/my_profile"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</ScrollView>