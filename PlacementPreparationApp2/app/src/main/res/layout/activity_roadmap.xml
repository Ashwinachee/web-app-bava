<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placement_roadmap"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/choose_topic"
            android:textSize="16sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/javaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/java"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/dsaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dsa"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/aptitudeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aptitude"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/dbmsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dbms"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/osButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/os"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/cnButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cn"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/sqlButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sql"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/hrButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hr_interview"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</ScrollView>