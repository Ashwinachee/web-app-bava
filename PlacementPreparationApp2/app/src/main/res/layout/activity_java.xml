<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/java_preparation"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <TextView
            android:id="@+id/javaProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_percentage"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"/>

        <CheckBox
            android:id="@+id/topic1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/java_basics"
            android:textSize="18sp"/>

        <CheckBox
            android:id="@+id/topic2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/oops_topic"
            android:textSize="18sp"/>

        <CheckBox
            android:id="@+id/topic3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/arrays_strings"
            android:textSize="18sp"/>

        <CheckBox
            android:id="@+id/topic4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/exception_handling"
            android:textSize="18sp"/>

        <CheckBox
            android:id="@+id/topic5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/collections_topic"
            android:textSize="18sp"/>

        <CheckBox
            android:id="@+id/topic6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/multithreading_topic"
            android:textSize="18sp"/>

        <CheckBox
            android:id="@+id/topic7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/java_interview_questions"
            android:textSize="18sp"/>
        <Button
            android:id="@+id/completeJavaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mark Java as Completed"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>