<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/my_progress_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/progress_desc"
            android:textSize="16sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>

        <!-- Overall Progress -->
        <TextView
            android:id="@+id/overallProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overall_progress_format"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <ProgressBar
            android:id="@+id/overallProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="25dp"/>

        <!-- Java -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/java"
            android:textSize="18sp"
            android:textStyle="bold"/>
        <SeekBar
            android:id="@+id/javaProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"/>

        <!-- DSA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dsa"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>
        <SeekBar
            android:id="@+id/dsaProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"/>

        <!-- Aptitude -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/aptitude"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>
        <SeekBar
            android:id="@+id/aptitudeProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"/>

        <!-- DBMS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dbms"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>
        <SeekBar
            android:id="@+id/dbmsProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"/>

        <!-- Operating Systems -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/operating_systems"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>
        <SeekBar
            android:id="@+id/osProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"/>

        <!-- Computer Networks -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/computer_networks"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>
        <SeekBar
            android:id="@+id/cnProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"/>

        <!-- SQL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sql"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>
        <SeekBar
            android:id="@+id/sqlProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"/>

        <!-- HR Interview -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hr_interview"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="15dp"/>
        <SeekBar
            android:id="@+id/hrProgressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"/>

        <!-- Save Button -->
        <Button
            android:id="@+id/saveProgressButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_progress"
            android:textSize="18sp"
            android:layout_marginTop="25dp"/>

    </LinearLayout>
</ScrollView>