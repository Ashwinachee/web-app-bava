<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hr_preparation_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hr_desc"
            android:textSize="16sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/introButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hr_intro"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/strengthButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hr_strengths"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/whyCompanyButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hr_why_hire"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/whyCompanyButton2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hr_why_company"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/goalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hr_goals"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/teamworkButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hr_teamwork"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/conflictButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hr_conflict"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/questionsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hr_ask_interviewer"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/mockButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hr_mock"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</ScrollView>