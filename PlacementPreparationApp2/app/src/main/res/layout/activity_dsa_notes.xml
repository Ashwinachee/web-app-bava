<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dsa_notes_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dsa_notes_desc"
            android:textSize="16sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"/>


        <Button
            android:id="@+id/arraysNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/arrays_topic"
            android:textSize="18sp"/>


        <Button
            android:id="@+id/stringsNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/strings_topic"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>


        <Button
            android:id="@+id/linkedListNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/linked_list"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>


        <Button
            android:id="@+id/stackNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stack"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>


        <Button
            android:id="@+id/queueNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/queue"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>


        <Button
            android:id="@+id/hashingNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hashing"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>


        <Button
            android:id="@+id/recursionNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/recursion"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>


        <Button
            android:id="@+id/binarySearchNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/binary_search"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>


        <Button
            android:id="@+id/treesNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trees"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>


        <Button
            android:id="@+id/graphsNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/graphs"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>


        <Button
            android:id="@+id/dpNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dynamic_programming"
            android:textSize="18sp"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</ScrollView>