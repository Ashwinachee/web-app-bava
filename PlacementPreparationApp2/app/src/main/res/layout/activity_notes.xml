<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/study_notes_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notes_desc"
            android:textSize="16sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="25dp"/>

        <Button
            android:id="@+id/javaNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/java_notes"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/dsaNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dsa_notes"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/aptitudeNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aptitude_notes"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/dbmsNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dbms_notes"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/osNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/os_notes"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/sqlNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sql_notes"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/cnNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Computer Networks Notes"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/hrNotesButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HR Interview Notes"
            android:textSize="18sp"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</ScrollView>