<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💻  Operating Systems"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Important OS concepts for placements"
            android:textSize="16sp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/processButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️  Process Management"
            android:textSize="18sp" />

        <Button
            android:id="@+id/threadsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧵  Threads"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/memoryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🧠  Memory Management"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/deadlockButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒  Deadlock"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/cpuSchedulingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏱️  CPU Scheduling"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/fileSystemButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📁  File Systems"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/pagingButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📄  Paging &amp; Segmentation"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/syncButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔄  Synchronization"
            android:textSize="18sp"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
